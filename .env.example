# Artemis Environment Configuration
ARTEMIS_ENV=development

# Google AI Studio API (Inference & RAG)
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Mosquitto MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=telemetry
DISK_BUFFER_DIR=/tmp/artemis/buffer

# MinIO Object Storage (S3 Compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=telemetry
MINIO_USE_SSL=false

# PostgreSQL (Relational State & Audit Logs)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=artemis_secure_password

# Redis (Semantic Cache & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Memgraph (Graph Intelligence Engine)
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# SpiderFoot OSINT Standalone
SPIDERFOOT_HOST=localhost
SPIDERFOOT_PORT=5001

# Traefik Reverse Proxy & Basic Auth
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8088
ARTEMIS_AUTH_USER=analyst
ARTEMIS_AUTH_PASSWORD=artemis_analyst_password
